{
  "manifest_version": 2,
  "name": "Custom Input Everywhere",
  "version": "1.0",
  "description": "A floating input box extension that syncs user input and allows AI enhancements.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/floatbox.css"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "commands": {
    "toggle_habit_mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Toggle Habit Mode"
    },
    "toggle_advanced_mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Toggle Advanced Mode"
    }
  }
}