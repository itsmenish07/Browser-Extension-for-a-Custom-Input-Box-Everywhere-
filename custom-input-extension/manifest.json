{
  "manifest_version": 2,
  "name": "Habit/Advanced Input Box",
  "version": "1.0",
  "description": "Floating Input box with Habit and Advanced Modes.",
  "permissions": [
  "storage",
  "activeTab",
  "https://api.openai.com/"
],

  
  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Habit/Advanced Input Box"
  },

  "commands": {
    "toggle-habit-mode": {
      "suggested_key": { "default": "Ctrl+Shift+H" }
    },
    "toggle-advanced-mode": {
      "suggested_key": { "default": "Ctrl+Shift+A" }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "icons": {
    "48": "icons/icon-48.png"
  }
}
