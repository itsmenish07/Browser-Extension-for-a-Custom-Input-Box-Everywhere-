{
  "manifest_version": 3,
  "name": "Custom Input Everywhere",
  "version": "1.0",
  "description": "A floating input box extension with smart typing and AI-powered modes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/floatbox.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      }
    },
    "toggle_habit_mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Toggle Habit Mode"
    },
    "toggle_advanced_mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Toggle Advanced Mode"
    }
  }
}